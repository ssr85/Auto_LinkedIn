# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: OpenRouter Key (useful if OpenAI/Anthropic quotas are low)
# Use format: provider/model-name (e.g., openai/gpt-4o or anthropic/claude-3.5-sonnet)
OPENROUTER_API_KEY=

# Provider Toggle Flags (true/false)
USE_OPENAI=true
USE_ANTHROPIC=true
USE_OPENROUTER=true

# Trello Configuration
TRELLO_API_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token
TRELLO_BOARD_ID=your_trello_board_id
TRELLO_TOPICS_LIST_ID=topics_list_id
TRELLO_CONTENT_LIST_ID=content_list_id

# LinkedIn Configuration
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=your_linkedin_refresh_token
LINKEDIN_USER_ID=your_linkedin_user_id

# Research Configuration
TARGET_URL=https://example.com
TARGET_INDUSTRY=Technology
RESEARCH_FREQUENCY_HOURS=24
MAX_TOPICS_PER_RESEARCH=5

# SERPER
SERPER_API_KEY=


# AI Model Configuration (e.g. gpt-4o, claude-3-5-sonnet-20241022)
# If using OpenRouter, use format: provider/model (e.g. google/gemini-pro-1.5, meta-llama/llama-3.1-8b-instruct)
AI_MODEL=google/gemini-pro-1.5
RESEARCH_MODEL=meta-llama/llama-3.1-8b-instruct


# Logging
LOG_LEVEL=INFO

# Image AI (Hugging Face)
HUGGINGFACE_API_TOKEN=your_token_here

# Figma Integration
FIGMA_ACCESS_TOKEN=your_token_here
FIGMA_PROJECT_ID=575383600  # Numeric ID from the project URL

# Opt-in
GENERATE_CREATIVES=true
BRAND_GUIDELINES_FILE=brand_guidelines/nugen.json
