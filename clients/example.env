# ============================================================
# Client env template — copy to clients/<your_client_name>.env
# and fill in all values for that client.
# ============================================================

# Optional: human-readable label used in logs and reports.
# Defaults to the filename stem if not set.
# CLIENT_NAME=acme_corp

# ------------------------------------------------------------
# AI / Search API keys
# (can be shared across clients if you use the same accounts)
# ------------------------------------------------------------
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...   # Optional — only needed for Claude models
# SERPER_API_KEY=...             # Optional — needed for web research tool

# ------------------------------------------------------------
# Trello — each client must have their own board + 5 lists
# ------------------------------------------------------------
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# List IDs (in order of the workflow):
TRELLO_TOPICS_LIST_ID=        # Stage 1 — Pending Topics
TRELLO_APPROVED_TOPICS_ID=    # Stage 2 — Approved Topics
TRELLO_CONTENT_APPROVAL_ID=   # Stage 3 — Pending Content
TRELLO_APPROVED_CONTENT_ID=   # Stage 4 — Approved Content
TRELLO_ARCHIVE_LIST_ID=       # Stage 5 — Content Archive

# ------------------------------------------------------------
# LinkedIn — each client must have their own access token
# ------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_USER_ID=
# LINKEDIN_CLIENT_ID=          # Optional — needed for token refresh
# LINKEDIN_CLIENT_SECRET=      # Optional — needed for token refresh
# LINKEDIN_REFRESH_TOKEN=      # Optional — enables automatic token refresh

# ------------------------------------------------------------
# Research target (per-client)
# ------------------------------------------------------------
TARGET_URL=https://example.com
TARGET_INDUSTRY=Technology

# ------------------------------------------------------------
# Content settings (optional — these have sensible defaults)
# ------------------------------------------------------------
# AI_MODEL=gpt-4-turbo-preview
# RESEARCH_FREQUENCY_HOURS=24
# MAX_TOPICS_PER_RESEARCH=5
# CONTENT_MIN_LENGTH=500
# CONTENT_MAX_LENGTH=3000
# LOG_LEVEL=INFO
